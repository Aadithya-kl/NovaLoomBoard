{
  "name": "novaloomboard",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, open-source digital whiteboard for Windows.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghaithheni/NovaLoomBoard.git"
  },
  "homepage": "https://github.com/ghaithheni/NovaLoomBoard#readme",
  "bugs": {
    "url": "https://github.com/ghaithheni/NovaLoomBoard/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @novaloom/desktop dev",
    "dev:web": "pnpm --filter @novaloom/web dev",
    "build": "pnpm --filter @novaloom/web build && pnpm --filter @novaloom/desktop build",
    "start": "pnpm build && pnpm --filter @novaloom/desktop exec electron .",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "package": "pnpm --filter @novaloom/desktop package"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
